{
	"name": "eslint-plugin-arrow",
	"version": "0.0.0-semantic-release",
	"description": "Lint rules that convert functions to arrow functions and declare them before use, with precise autofixes that keep your formatting. Works with ESLint and Oxlint.",
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"oxlint",
		"arrow-functions",
		"prefer-arrow-functions",
		"hoisting",
		"no-use-before-define",
		"autofix"
	],
	"license": "MIT",
	"repository": "privatenumber/eslint-plugin-arrow",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"oxlint.json"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./oxlint": {
			"types": "./dist/oxlint.d.mts",
			"default": "./dist/oxlint.mjs"
		}
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"scripts": {
		"build": "pkgroll",
		"lint": "lintroll --cache --git",
		"test": "node tests/index.ts && node tests/smoke.js",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"eslint": ">=9"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/config-helpers": "^0.7.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "^8.72.1",
		"@typescript-eslint/rule-tester": "^8.72.1",
		"@typescript-eslint/utils": "^8.72.1",
		"clean-pkg-json": "^2.0.0",
		"eslint": "^10.13.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.32.1",
		"manten": "^2.0.2",
		"nano-spawn": "^2.1.0",
		"oxlint": "^1.90.0",
		"pkgroll": "^2.29.0",
		"typescript": "^6.0.3"
	}
}
